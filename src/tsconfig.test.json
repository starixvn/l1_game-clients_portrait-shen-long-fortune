{
    "compilerOptions": {
        "strict": false,
        "outDir": "dist",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "paths": {
            "cc": ["./tests/cocos-testing/cc"],
            "db://shared-cluster-cascading/*": ["./extensions/shared-cluster-cascading/assets/*"],
            "db://shared-common-slot/*": ["./extensions/shared-common-slot/assets/*"],
            "db://shared-components/*": ["./extensions/shared-components/assets/*"],
            "db://i18n/*": ["./extensions/i18n/assets/*"],
            "db://assets/*": ["./assets/*"]
        }
    }
}
